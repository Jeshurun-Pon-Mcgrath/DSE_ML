# Copy this file to .env at the repository root. Never commit .env.
# Browser variables are public; VITE_* must never contain secrets.
VITE_API_BASE_URL=http://localhost:8000

RISKBYTE_ENVIRONMENT=development
RISKBYTE_LOG_LEVEL=INFO
RISKBYTE_CORS_ORIGINS=["http://localhost:5173"]
# Optional in Phase 0. Supply a secret-managed postgresql+psycopg URL in a later phase.
# RISKBYTE_DATABASE_URL=

# Phase 1: operator-owned JSON configuration; omit to remain dataset_not_configured.
# Paths below are resolved from the repository root.
# RISKBYTE_DATASET_CONFIG_PATH=ml/config/dataset.local.json
# RISKBYTE_DATASET_ARTIFACTS_DIR=ml/artifacts
# Phase 1.5: opt in when IEEE-CIS sources are available. No paths accepted over HTTP.
# RISKBYTE_DATASET_ADAPTER=ieee_cis
# RISKBYTE_DATASET_CONFIG_PATH=ml/config/ieee_cis.local.json
# RISKBYTE_DATASET_ARTIFACTS_DIR=ml/artifacts/ieee_cis
# Synthetic academic development dataset (generate explicitly; no startup generation):
# RISKBYTE_DATASET_ADAPTER=synthetic_riskbyte
# RISKBYTE_DATASET_CONFIG_PATH=ml/config/synthetic_riskbyte.example.json
# RISKBYTE_DATASET_ARTIFACTS_DIR=ml/artifacts/synthetic_riskbyte
# Phase 3 offline snapshots; parent directory also contains frozen features/splits.
# RISKBYTE_STATISTICS_ARTIFACTS_DIR=ml/artifacts/statistics
# Phase 4 read-only registry; parent holds frozen feature/split/preprocessing artifacts.
# RISKBYTE_MODEL_ARTIFACTS_DIR=ml/artifacts/models
# Final API defaults (no credentials). Production writes require an operator-provided key.
# RISKBYTE_INFERENCE_ENABLED=true
# RISKBYTE_MAX_BATCH_SIZE=500
# RISKBYTE_MAX_REQUEST_BYTES=2000000
# RISKBYTE_DEVELOPMENT_DATABASE_PATH=ml/artifacts/api.sqlite3
# RISKBYTE_WRITE_API_KEY=
